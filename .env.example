# Database (PostgreSQL — Neon or Supabase connection string)
DATABASE_URL="postgresql://user:password@host:5432/writing_buddy?sslmode=require"

# Auth.js secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OpenRouter API key encryption
# Generate with: openssl rand -hex 32  (must be exactly 32 bytes when decoded)
OPENROUTER_ENCRYPTION_KEY="your-32-byte-hex-key-here"
